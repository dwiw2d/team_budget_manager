{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // supabase/functions/ocr 는 Deno 에서도 돌아야 해서 import 에 .ts 확장자를 그대로 쓴다.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "supabase/functions/ocr/**/*.ts"],
  "exclude": ["supabase/functions/ocr/index.ts"]
}
